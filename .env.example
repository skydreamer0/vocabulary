# Dedicated vocabulary Supabase project only. Publishable keys are designed for browsers.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_PROJECT_KEY
# Canonical production origin; no trailing slash. Set localhost for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Never add a service_role/secret key to NEXT_PUBLIC_* or to this app.
