# Neon pooled connection for application traffic (server-only).
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct connection for migrations (server-only).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Neon Console > Auth > Configuration, or Vercel integration environment variables.
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
# Generate a random secret of at least 32 characters. Never commit the real value.
NEON_AUTH_COOKIE_SECRET=
# Local API tests only. Never set on Vercel production.
# TEST_AUTH_SECRET=local-test-secret
